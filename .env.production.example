# Living World Engine — 베타 프로덕션 환경 변수 템플릿
# 실값은 호스팅 플랫폼(Fly/Railway 등)에만 등록. 저장소에 커밋하지 말 것.
# cp .env.production.example → 플랫폼 secret/UI에 항목별 입력
# 점검: poetry run python backend/scripts/check_beta_env.py --strict

# --- 필수 ---
DATABASE_URL=postgresql://USER:PASS@HOST:5432/living_world
JWT_SECRET=                          # openssl rand -hex 32
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-5-20250929
# ENABLE_SINGLE_PASS=true
# LLM_MAX_TOKENS=768

# --- 보안 ---
DEBUG=false
CORS_ORIGINS=https://your-app.example
RATE_LIMITING_ENABLED=true

# --- 베타 가입·쿼터 ---
REQUIRE_INVITE_CODE_FOR_SIGNUP=true
MAX_TOTAL_USERS=200
ENFORCE_PLATFORM_TURN_QUOTA=true
PLATFORM_DAILY_TURN_LIMIT=20

# --- 비용 방어 (Epic E) ---
EMERGENCY_SHUTDOWN=false
PLATFORM_DAILY_COST_ALERT_THRESHOLD_USD=2.0
PLATFORM_COST_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
IMAGE_GEN_DAILY_BUDGET_USD=2.0
IMAGE_GEN_PER_USER_MONTHLY=20
IMAGE_GEN_NPC_PER_USER_MONTHLY=60

# --- Replicate (커버·NPC 초상) ---
REPLICATE_API_TOKEN=r8_...
IMAGE_MODEL_COVER=black-forest-labs/flux-1.1-pro
IMAGE_MODEL_NPC_AVATAR=black-forest-labs/flux-schnell
IMAGE_COVER_ASPECT_RATIO=16:9

# --- Cloudflare R2 (영구 이미지 URL — 다섯 값 모두) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=lwe-images
R2_PUBLIC_URL=https://images.your-domain.com

# --- 관측 ---
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
STRUCTURED_LOGGING=true

# --- Kakao OAuth (선택) ---
# KAKAO_LOGIN_ENABLED=true
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=https://your-app.example/api/auth/kakao/callback
# KAKAO_POST_LOGIN_REDIRECT=https://your-app.example/oauth/callback
