# API — Poetry, 프로젝트 루트가 컨텍스트
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1

# X-Forwarded-* 를 신뢰할 프록시 IP/CIDR (콤마 구분) — uvicorn 이 이 env 를 직접 읽는다.
# 기본 127.0.0.1 = 같은 호스트의 프록시만 신뢰. 런타임에 `-e FORWARDED_ALLOW_IPS=...` 로 덮어쓴다.
# `*` 는 API 포트가 외부에 노출되면 누구나 X-Forwarded-For 로 IP 를 위조해
# 레이트 리밋(클라이언트 IP 기준)을 우회할 수 있으므로 쓰지 말 것.
ENV FORWARDED_ALLOW_IPS=127.0.0.1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip && pip install "poetry>=1.8,<3"

COPY pyproject.toml poetry.lock ./
RUN poetry install --only main --no-ansi

COPY backend ./backend
COPY migrations ./migrations
COPY alembic.ini ./
COPY docker/docker-api-entrypoint.sh /docker-api-entrypoint.sh
RUN chmod +x /docker-api-entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/docker-api-entrypoint.sh"]
CMD ["uvicorn", "backend.src.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
