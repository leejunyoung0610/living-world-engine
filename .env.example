# Living World Engine - 환경 변수
# 이 파일을 .env로 복사하고 값을 입력하세요
# cp .env.example .env

# Claude API 키 (필수)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# 서버 설정
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 게임 설정
DEFAULT_WORLD=arcane_academy
MAX_TURNS_PER_SESSION=100
# LLM: 기본 Sonnet 4.5 (프로덕트 기준). 별칭: sonnet / sonnet45
LLM_MODEL=claude-sonnet-4-5-20250929
# LLM_MODEL=sonnet
# (개발·비용 실험용) Haiku ID 직접 지정 시 — 프롬프트는 Sonnet 경로와 동일
# LLM_MODEL=claude-haiku-4-5-20251001
# 출력 토큰 상한 (비용에 직결). 짧은 연출: 512~640, 기본: 768, 긴 멀티 NPC: 1024+
LLM_MAX_TOKENS=768
# Single-Pass: 1차에 대사+tool_use 동시 응답이면 2차 호출 생략 (기본 true). A/B 시 false
# ENABLE_SINGLE_PASS=true
# 장기기억: 저장된 기억 개수가 상한 초과 시 오래된 저중요도 묶음을 요약 1건으로 접음
# LTM_COMPACT_MAX_TOTAL=200
# LTM_COMPACT_MIN_BATCH=10
# LTM_COMPACT_IMPORTANCE_BELOW=50

# --- UGC MVP API (FastAPI) ---
# JWT 서명 — 로컬 개발만 아래 placeholder 허용. 프로덕션은 절대 기본값 금지(≥32바이트 난수).
# JWT_SECRET=change-me-only-for-local-dev
# CORS 허용 오리진 (콤마 구분). 프로덕션에는 실제 https:// 도메인만 넣을 것.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL — DB는 먼저 생성 (예: createdb living_world 또는 Docker POSTGRES_DB)
# 마이그레이션 (프로젝트 루트에서, 스크립트 폴더명이 `alembic`이면 패키지와 충돌하므로 `migrations/` 사용):
#   poetry run alembic upgrade head
#   또는: poetry run python -m alembic upgrade head
# DATABASE_URL=postgresql://postgres:dev@127.0.0.1:5432/living_world

# --- 프로덕션 (저장소에 실값 넣지 말 것; 플랫폼 env 또는 AWS SSM/Secrets Manager) ---
# DATABASE_URL=postgresql://user:pass@host:5432/living_world
# JWT_SECRET=<openssl rand -hex 32 등으로 생성>
# ANTHROPIC_API_KEY=sk-ant-...
# CORS_ORIGINS=https://your-app.example
# 자세한 절차: docs/DEPLOYMENT.md
# 계정당 UGC 월드 상한 (기본 3)
# MAX_WORLDS_PER_USER=3

# 가입 게이트 (Epic C) — 베타에서 true 로 두면 DB의 초대 코드 없이는 signup 불가
# REQUIRE_INVITE_CODE_FOR_SIGNUP=false
# 전체 가입자 상한 (미설정 시 제한 없음). 예: MAX_TOTAL_USERS=100
# MAX_TOTAL_USERS=
# 초대 코드 행 추가: poetry run python backend/scripts/create_invite_code.py YOUR-CODE --max-uses 5
