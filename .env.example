# Living World Engine - 환경 변수
# 이 파일을 .env로 복사하고 값을 입력하세요
# cp .env.example .env

# Claude API 키 (필수)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# 서버 설정
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 게임 설정
DEFAULT_WORLD=arcane_academy
MAX_TURNS_PER_SESSION=100
# LLM: 기본 Sonnet 4.5 (품질). Haiku 테스트: LLM_MODEL=haiku 또는 hikaru
LLM_MODEL=claude-sonnet-4-5-20250929
# LLM_MODEL=sonnet
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_MODEL=haiku
# LLM_MODEL=hikaru
LLM_MAX_TOKENS=2000
