# Living World Engine - 환경 변수
# 이 파일을 .env로 복사하고 값을 입력하세요
# cp .env.example .env

# Claude API 키 (필수) — 모든 유저 LLM 호출에 서버 이 키 하나를 사용합니다.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# 서버 설정
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 게임 설정
DEFAULT_WORLD=arcane_academy
MAX_TURNS_PER_SESSION=100
# LLM: 기본 Sonnet 4.5 (프로덕트 기준). 별칭: sonnet / sonnet45
LLM_MODEL=claude-sonnet-4-5-20250929
# LLM_MODEL=sonnet
# (개발·비용 실험용) Haiku ID 직접 지정 시 — 프롬프트는 Sonnet 경로와 동일
# LLM_MODEL=claude-haiku-4-5-20251001
# 출력 토큰 상한 (비용에 직결). 짧은 연출: 512~640, 기본: 768, 긴 멀티 NPC: 1024+
LLM_MAX_TOKENS=768
# Single-Pass: 1차에 대사+tool_use 동시 응답이면 2차 호출 생략 (기본 true). A/B 시 false
# ENABLE_SINGLE_PASS=true
# 장기기억: 저장된 기억 개수가 상한 초과 시 오래된 저중요도 묶음을 요약 1건으로 접음
# LTM_COMPACT_MAX_TOTAL=200
# LTM_COMPACT_MIN_BATCH=10
# LTM_COMPACT_IMPORTANCE_BELOW=50

# --- UGC MVP API (FastAPI) ---
# JWT 서명 — 로컬 개발만 아래 placeholder 허용. 프로덕션은 절대 기본값 금지(≥32바이트 난수).
# JWT_SECRET=change-me-only-for-local-dev
# CORS 허용 오리진 (콤마 구분). 프로덕션에는 실제 https:// 도메인만 넣을 것.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL — DB는 먼저 생성 (예: createdb living_world 또는 Docker POSTGRES_DB)
# 마이그레이션 (프로젝트 루트에서, 스크립트 폴더명이 `alembic`이면 패키지와 충돌하므로 `migrations/` 사용):
#   poetry run alembic upgrade head
#   또는: poetry run python -m alembic upgrade head
# DATABASE_URL=postgresql://postgres:dev@127.0.0.1:5432/living_world

# --- 프로덕션 (저장소에 실값 넣지 말 것; 플랫폼 env 또는 AWS SSM/Secrets Manager) ---
# DATABASE_URL=postgresql://user:pass@host:5432/living_world
# JWT_SECRET=<openssl rand -hex 32 등으로 생성>
# ANTHROPIC_API_KEY=sk-ant-...
# CORS_ORIGINS=https://your-app.example
# 자세한 절차: docs/DEPLOYMENT.md
# 계정당 UGC 월드 상한 (기본 3)
# MAX_WORLDS_PER_USER=3

# 가입 게이트 (Epic C) — 베타에서 true 로 두면 DB의 초대 코드 없이는 signup 불가
# REQUIRE_INVITE_CODE_FOR_SIGNUP=false
# 전체 가입자 상한 (미설정 시 제한 없음). 예: MAX_TOTAL_USERS=100
# MAX_TOTAL_USERS=
# 초대 코드 행 추가: poetry run python backend/scripts/create_invite_code.py YOUR-CODE --max-uses 5

# 플랫폼 키 일일 턴 쿼터 (Epic D) — UTC 자정 기준.
# ENFORCE_PLATFORM_TURN_QUOTA=false
# PLATFORM_DAILY_TURN_LIMIT=20

# slowapi 레이트 리밋 (가입·로그인·턴). 테스트는 기본 비활성.
# RATE_LIMITING_ENABLED=true

# Epic E — 일일 플랫폼 추정 비용(UsageTracker 단가) 알림·긴급 셧다운
# EMERGENCY_SHUTDOWN=false
# PLATFORM_DAILY_COST_ALERT_THRESHOLD_USD=50
# PLATFORM_COST_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Kakao OAuth (소셜 로그인) ---
# 카카오 디벨로퍼스 → 내 애플리케이션 → 앱 키 → "REST API 키"
# Redirect URI 는 카카오 콘솔에 등록한 것과 글자 단위로 동일해야 함.
# KAKAO_LOGIN_ENABLED=false
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# Redirect URI 비우면 "요청 시점 브라우저 호스트"(예: Vite 로컬)에서 자동 도출.
# Kakao 앱에는 아래처럼 실제 접속 호스트별로 등록 (localhost vs 127.0.0.1 도 다름).
#   http://localhost:5173/api/auth/kakao/callback
#   http://127.0.0.1:5173/api/auth/kakao/callback
# (nginx로 8080만 쓰면) http://localhost:8080/api/auth/kakao/callback
# KAKAO_REDIRECT_URI=
# 비우면 /oauth/callback 은 브라우저 호스트에 붙음. 위와 같을 때 명시 필요 없음—다만 과거처럼
# 호스트 불일치가 나면: KAKAO_POST_LOGIN_REDIRECT=http://localhost:5173/oauth/callback
# KAKAO_POST_LOGIN_REDIRECT=

# Epic H — Sentry(비우면 비활성)·구조화 액세스 로그(JSON). 프로덕션은 STRUCTURED_LOGGING=true 권장.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
# STRUCTURED_LOGGING=false

# 월드 커버 AI(Replicate — Flux 등). 비우면 에디터「AI 커버 생성」API 는 503.
# REPLICATE_API_TOKEN=r8_...
# IMAGE_MODEL_COVER=black-forest-labs/flux-1.1-pro
# IMAGE_COVER_ASPECT_RATIO=16:9
# IMAGE_COVER_OUTPUT_QUALITY=90
# 계정·월드당 월별 생성 횟수 — 한 축 한도를 끄려면 해당 값만 0
# IMAGE_GEN_PER_USER_MONTHLY=20
# IMAGE_GEN_PER_WORLD_MONTHLY=4
# UTC 일별 추정 비용 한도 — None/비우면 미적용. 단가는 IMAGE_GEN_COVER_COST_ESTIMATE_USD
# IMAGE_GEN_DAILY_BUDGET_USD=2.0
# IMAGE_GEN_COVER_COST_ESTIMATE_USD=0.04
# IMAGE_NPC_AVATAR_COST_ESTIMATE_USD=0.008
# NPC 초상 — 별도 월별 쿼터 (기본 플루즈 schnell, SDXL 설정 시 크기 참고)
# IMAGE_MODEL_NPC_AVATAR=black-forest-labs/flux-schnell
# IMAGE_NPC_AVATAR_PIXELS=1024
# IMAGE_NPC_AVATAR_OUTPUT_QUALITY=85
# IMAGE_GEN_NPC_PER_USER_MONTHLY=60
# IMAGE_GEN_NPC_PER_WORLD_MONTHLY=30
# 일 예산 알림 — Epic E 웹훅과 동일: PLATFORM_COST_ALERT_WEBHOOK_URL (커버+NPC 초상 추정 비용 합계)

# Cloudflare R2 (선택) — 다섯 값이 모두 있으면 생성 직후 버킷으로 복사하고 ``R2_PUBLIC_URL`` 기준 영구 URL 저장.
# 하나라도 비우면 Replicate 가 준 임시 CDN URL 만 저장됩니다.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=lwe-images
# 슬래시 없이 예: https://images.your-domain.com 또는 R2 r2.dev 퍼블릭 URL
# R2_PUBLIC_URL=https://pub-xxx.r2.dev
